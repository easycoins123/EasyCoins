{
  "name": "top-token-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Top Token commerce backend — Phase 4A foundation",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:up": "node scripts/dev-db.mjs start",
    "db:down": "node scripts/dev-db.mjs stop",
    "db:reset": "node scripts/dev-db.mjs reset",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "test": "node scripts/with-db.mjs npm run test:inner",
    "test:watch": "jest --watch --runInBand",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:stop": "node scripts/dev-db.mjs stop",
    "with-db": "node scripts/with-db.mjs",
    "migrate:status": "prisma migrate status",
    "db:init": "node scripts/with-db.mjs npm run db:init:inner",
    "db:init:inner": "prisma migrate deploy && npm run seed",
    "test:unit": "jest --runInBand --testPathIgnorePatterns integration",
    "test:inner": "prisma migrate deploy && npm run seed && jest --runInBand",
    "start:e2e": "prisma migrate deploy && npm run seed && ts-node --transpile-only src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "^17.5.0-beta.15",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  }
}
