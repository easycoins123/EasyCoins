// Top Token — PostgreSQL schema (Phase 4A)
//
// Derived from docs/DATABASE-DESIGN.md. Only tables with a live purpose in this
// phase are present; the design document lists a few more (inventory_units for
// serialised code pools, refunds) that Phase 4B will add when real fulfillment
// and refunds arrive.
//
// Money is ALWAYS an integer count of minor units plus a currency. `Int` rather
// than `BigInt`: the maximum is ~2.1 billion agorot (21M ILS) per row, far above
// any single line, and it serialises to JSON without BigInt gymnastics.
//
// Deviation from the design doc: it suggested CHECK constraints over TEXT rather
// than native enums, to avoid a table rewrite when adding a value. Prisma models
// enums natively and modern PostgreSQL adds an enum value without a rewrite, so
// the type safety is worth more than the avoided caution. Documented in
// docs/BACKEND-IMPLEMENTATION.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime connection. On a serverless host this MUST be a pooled connection
  // (Supabase's transaction-mode pooler on port 6543), because every cold start
  // opens its own connection and a direct 5432 connection pool is exhausted in
  // minutes. On an always-on host the two URLs can be the same value.
  url      = env("DATABASE_URL")
  // Migrations and introspection need a direct, unpooled connection: the
  // transaction pooler does not support the session-level statements Prisma runs
  // to apply a migration. Points at port 5432. Falls back to the runtime URL if
  // unset, so a non-pooled deployment needs no second variable.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlatformKind {
  PLAYSTATION_5
  PLAYSTATION_4
  XBOX
  PC
  MOBILE
  MULTI_PLATFORM
}

enum PlatformFamily {
  PLAYSTATION
  XBOX
  PC
  MOBILE
  ANY
}

enum RegionCode {
  IL
  US
  UK
  EU
  GLOBAL
}

enum ProductType {
  DIGITAL_CODE
  GIFT_CARD
  SUBSCRIPTION
  GAME_CURRENCY
  DLC
  GAME
  PLAYER_SERVICE
  ACCOUNT_SERVICE
  OTHER
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  DISCONTINUED
}

enum FulfillmentMethod {
  DIGITAL_CODE
  AUTOMATED_API
  MANUAL_REVIEW
  MANUAL_DELIVERY
  IN_GAME_SERVICE
  NOT_SUPPORTED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  WAITING_FOR_CUSTOMER
  READY
  DELIVERED
  FAILED
  CANCELLED
  REFUNDED
}

enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
  EXPIRED
}

enum CheckoutSessionStatus {
  OPEN
  VALIDATING
  READY_FOR_PAYMENT
  PAYMENT_PENDING
  COMPLETED
  EXPIRED
  CANCELLED
}

/// Must match `OrderStatus` in src/app/domain/order/order.ts member for member.
/// The frontend maps an unrecognised value to PROCESSING, so a mismatch would
/// not error: a DELIVERED order would silently render as "being prepared".
enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  FULFILLMENT_PENDING
  FULFILLMENT_PROCESSING
  FULFILLED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

/// CREATED..CANCELLED match the frontend domain exactly.
///
/// EXPIRED is an internal state the frontend has no member for. It is stored so
/// the sweep that abandons stale intents has somewhere truthful to record the
/// outcome, and it is translated to CANCELLED at the DTO boundary rather than
/// being emitted on the wire, where the frontend would fall back to PROCESSING
/// and tell the customer their payment was still in flight.
enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentProviderId {
  MOCK
  ISRAEL_CARD
  BIT
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
}

enum PromotionKind {
  PERCENT_OFF
  AMOUNT_OFF
  BUNDLE_DEAL
  PRIORITY_DELIVERY
}

enum SupportTopic {
  ORDER_STATUS
  DELIVERY_PROBLEM
  PAYMENT_PROBLEM
  REFUND_REQUEST
  REGION_PROBLEM
  GENERAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum AuthProvider {
  GOOGLE
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ActorType {
  CUSTOMER
  SYSTEM
  OPERATOR
  PROVIDER
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Game {
  id               String   @id
  slug             String   @unique
  name             Json
  publisher        String
  shortDescription Json     @map("short_description")
  accentColor      String?  @map("accent_color")
  coverUrl         String?  @map("cover_url")
  heroUrl          String?  @map("hero_url")
  // platformIds is NOT stored. A String[] cannot carry a foreign key, so it
  // could name a platform that does not exist, or claim support the catalog
  // cannot actually sell. It is derived from the game's offers instead.
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([active, sortOrder])
  @@map("games")
}

model Platform {
  id        String         @id
  kind      PlatformKind
  family    PlatformFamily
  name      Json
  shortName Json           @map("short_name")
  sortOrder Int            @default(0) @map("sort_order")

  offers        Offer[]
  checkoutItems CheckoutItem[]
  orderItems    OrderItem[]

  @@map("platforms")
}

model Region {
  id                String     @id
  code              RegionCode @unique
  name              Json
  market            String?
  currency          String     @db.Char(3)
  flagEmoji         String?    @map("flag_emoji")
  isRegionFree      Boolean    @map("is_region_free")
  // Required whenever isRegionFree is false — enforced by a CHECK constraint
  // added in the migration. A region-locked region with no customer-facing
  // notice is a silent trap, so the database refuses it.
  restrictionNotice Json?      @map("restriction_notice")

  offers           Offer[]
  checkoutSessions CheckoutSession[]
  checkoutItems    CheckoutItem[]
  orders           Order[]
  orderItems       OrderItem[]

  @@map("regions")
}

model Product {
  id               String      @id
  gameId           String      @map("game_id")
  slug             String      @unique
  type             ProductType
  name             Json
  shortDescription Json        @map("short_description")
  description      Json
  images           Json        @default("[]")
  metadata         Json        @default("{}")
  tags             String[]    @default([])
  // platformIds and regionIds are NOT stored, for the same reason as on Game:
  // an array cannot be foreign-keyed, and a product that lists PS5 without a
  // PS5 offer would be advertising something nobody can buy. Both are derived
  // from this product's offers, which makes the badge on a card a statement
  // about real purchasable inventory.
  //
  // ratingAverage and ratingCount are likewise derived, from published reviews.
  // Storing them invites the number drifting from the rows behind it, and a
  // rating count that does not correspond to real reviews is a fabricated trust
  // signal.
  active           Boolean     @default(true)
  featured         Boolean     @default(false)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  game       Game             @relation(fields: [gameId], references: [id])
  variants   ProductVariant[]
  offers     Offer[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([gameId, active])
  @@index([active, featured])
  @@map("products")
}

model ProductVariant {
  id            String  @id
  productId     String  @map("product_id")
  name          Json
  sku           String  @unique
  // Int, not NUMERIC as docs/DATABASE-DESIGN.md suggests: every quantity we
  // sell is a whole unit (coins, points, months, a shekel denomination), and an
  // integer avoids Prisma's Decimal type leaking into JSON serialisation.
  quantityValue Int?    @map("quantity_value")
  quantityUnit  Json?   @map("quantity_unit")
  metadata      Json    @default("{}")
  sortOrder     Int     @default(0) @map("sort_order")
  active        Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers     Offer[]
  orderItems OrderItem[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

/// The unit of commerce: variant x platform x region, with its own price,
/// inventory, delivery method and checkout requirements.
model Offer {
  id                   String            @id
  productId            String            @map("product_id")
  variantId            String            @map("variant_id")
  platformId           String            @map("platform_id")
  regionId             String            @map("region_id")
  priceAmountMinor     Int               @map("price_amount_minor")
  priceCurrency        String            @map("price_currency") @db.Char(3)
  compareAtMinor       Int?              @map("compare_at_minor")
  fulfillmentMethod    FulfillmentMethod @map("fulfillment_method")
  checkoutRequirements Json              @default("[]") @map("checkout_requirements")
  terms                Json?
  maxPerOrder          Int               @default(10) @map("max_per_order")
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  product       Product                @relation(fields: [productId], references: [id])
  variant       ProductVariant         @relation(fields: [variantId], references: [id])
  platform      Platform               @relation(fields: [platformId], references: [id])
  region        Region                 @relation(fields: [regionId], references: [id])
  inventory     Inventory?
  reservations  InventoryReservation[]
  cartItems     CartItem[]
  checkoutItems CheckoutItem[]
  orderItems    OrderItem[]

  // One offer per commercial configuration: otherwise "the" price of a variant
  // on a platform in a region would be ambiguous.
  @@unique([variantId, platformId, regionId], name: "offer_configuration")
  @@index([productId, active])
  @@index([priceAmountMinor])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Inventory {
  offerId           String          @id @map("offer_id")
  status            InventoryStatus
  /// NULL means unlimited — a manual service has no unit count.
  quantityAvailable Int?            @map("quantity_available")
  quantityReserved  Int             @default(0) @map("quantity_reserved")
  quantitySold      Int             @default(0) @map("quantity_sold")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryReservation {
  id                String            @id
  offerId           String            @map("offer_id")
  checkoutSessionId String            @map("checkout_session_id")
  orderId           String?           @map("order_id")
  quantity          Int
  status            ReservationStatus
  expiresAt         DateTime          @map("expires_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  offer           Offer           @relation(fields: [offerId], references: [id])
  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  order           Order?          @relation(fields: [orderId], references: [id])

  @@index([status, expiresAt])
  @@index([offerId, status])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------------------------
// Customers and sessions
// ---------------------------------------------------------------------------

/// No password column exists and none may ever be added. Authentication is an
/// emailed one-time code; there is nothing here to phish, reuse or leak.
model Customer {
  id                 String         @id
  email              String         @unique
  displayName        String?        @map("display_name")
  phone              String?
  preferredLocale    String         @default("he") @map("preferred_locale")
  preferredRegion    RegionCode     @default(IL) @map("preferred_region")
  status             CustomerStatus @default(ACTIVE)
  emailVerified      Boolean        @default(false) @map("email_verified")
  /// Nullable on purpose. Customers created before passwords existed, and
  /// customers who only ever sign in with Google, legitimately have none.
  /// A null hash means "this account has no password", never "any password".
  passwordHash       String?        @map("password_hash")
  passwordUpdatedAt  DateTime?      @map("password_updated_at")
  lastLoginAt        DateTime?      @map("last_login_at")
  marketingConsent   Boolean        @default(false) @map("marketing_consent")
  marketingConsentAt DateTime?      @map("marketing_consent_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  sessions         CustomerSession[]
  identities       AuthIdentity[]
  passwordResets   PasswordReset[]
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
  reviews          Review[]
  supportTickets   SupportTicket[]
  rewards          CustomerReward[]
  founderSeat      FounderSeat?
  referralCode     ReferralCode?

  @@map("customers")
}

/// One-time sign-in codes. Only the hash is stored; the plaintext exists solely
/// in the email that carried it.
/// A federated sign-in linked to a customer, one row per provider account.
///
/// Kept separate from `customers` so a person can have both a password and a
/// Google login, and so adding a second provider later is a row rather than a
/// migration. Nothing here is a credential: the provider authenticates, and we
/// store only the opaque account id it gives us.
model AuthIdentity {
  id                String       @id
  customerId        String       @map("customer_id")
  provider          AuthProvider
  /// The provider's own immutable id for the account. Never the email, which
  /// can change and be reassigned.
  providerAccountId String       @map("provider_account_id")
  /// Email as the provider reported it, for support and for audit only.
  providerEmail     String?      @map("provider_email")
  createdAt         DateTime     @default(now()) @map("created_at")
  lastUsedAt        DateTime?    @map("last_used_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// One provider account maps to exactly one customer.
  @@unique([provider, providerAccountId], name: "identity_provider_account")
  @@index([customerId])
  @@map("auth_identities")
}

/// A password reset token. Only its hash is stored, like a session token.
model PasswordReset {
  id         String    @id
  customerId String    @map("customer_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  requestIp  String?   @map("request_ip")
  createdAt  DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, consumedAt])
  @@map("password_resets")
}

model AuthCode {
  id         String    @id
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  requestIp  String?   @map("request_ip")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, expiresAt])
  @@map("auth_codes")
}

/// Browser sessions. `tokenHash` is a hash of the cookie value — the cookie
/// itself is never stored, so a database leak does not yield live sessions.
///
/// A session exists for anonymous visitors too: it is what ties an anonymous
/// order to the browser that created it, which is how order authorization works
/// before someone signs in.
model CustomerSession {
  id         String    @id
  customerId String?   @map("customer_id")
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
  rewards          CustomerReward[]

  @@index([customerId, revokedAt])
  @@map("customer_sessions")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

/// Cart lines store no price. The cart is a list of intentions; pricing is
/// derived on read from the offer. This is the schema-level expression of
/// "the client never decides what a customer pays".
model Cart {
  id         String   @id
  customerId String?  @map("customer_id")
  sessionId  String?  @map("session_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer?        @relation(fields: [customerId], references: [id])
  session  CustomerSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id       String   @id
  cartId   String   @map("cart_id")
  offerId  String   @map("offer_id")
  quantity Int
  addedAt  DateTime @default(now()) @map("added_at")

  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([cartId, offerId], name: "cart_one_line_per_offer")
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Checkout
// ---------------------------------------------------------------------------

/// The commercial snapshot. `pricingSnapshot` and the frozen line prices are
/// written once and never updated, so a catalog price change cannot alter an
/// in-flight or historical purchase.
model CheckoutSession {
  id                   String                @id
  customerId           String?               @map("customer_id")
  sessionId            String?               @map("session_id")
  status               CheckoutSessionStatus @default(OPEN)
  pricingSnapshot      Json                  @map("pricing_snapshot")
  requirementsSnapshot Json                  @map("requirements_snapshot")
  currency             String                @db.Char(3)
  regionId             String                @map("region_id")
  subtotalMinor        Int                   @map("subtotal_minor")
  discountMinor        Int                   @default(0) @map("discount_minor")
  totalMinor           Int                   @map("total_minor")
  couponCode           String?               @map("coupon_code")
  /// The earned reward the customer chose to use on this order, if any. Its
  /// effect is frozen in `benefitsSnapshot` with the prices, for the same
  /// reason the prices are: what was quoted is what is honoured.
  rewardId             String?               @map("reward_id")
  benefitsSnapshot     Json?                 @map("benefits_snapshot")
  contactValues        Json?                 @map("contact_values")
  expiresAt            DateTime              @map("expires_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  customer       Customer?              @relation(fields: [customerId], references: [id])
  session        CustomerSession?       @relation(fields: [sessionId], references: [id])
  region         Region                 @relation(fields: [regionId], references: [id])
  items          CheckoutItem[]
  reservations   InventoryReservation[]
  order          Order?
  paymentIntents PaymentIntent[]

  @@index([status, expiresAt])
  @@map("checkout_sessions")
}

model CheckoutItem {
  id                String            @id
  checkoutSessionId String            @map("checkout_session_id")
  offerId           String            @map("offer_id")
  quantity          Int
  unitPriceMinor    Int               @map("unit_price_minor")
  totalPriceMinor   Int               @map("total_price_minor")
  regionId          String            @map("region_id")
  platformId        String            @map("platform_id")
  fulfillmentMethod FulfillmentMethod @map("fulfillment_method")
  displayName       Json              @map("display_name")
  displayVariant    Json              @map("display_variant")
  imageUrl          String?           @map("image_url")

  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  offer           Offer           @relation(fields: [offerId], references: [id])
  region          Region          @relation(fields: [regionId], references: [id])
  platform        Platform        @relation(fields: [platformId], references: [id])

  @@map("checkout_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                String      @id
  orderNumber       String      @unique @map("order_number")
  customerId        String?     @map("customer_id")
  sessionId         String?     @map("session_id")
  checkoutSessionId String      @unique @map("checkout_session_id")
  contactEmail      String      @map("contact_email")
  // An order begins awaiting payment. DRAFT exists in the vocabulary for a
  // future saved-basket feature and is never written by the current flow.
  status            OrderStatus @default(PENDING_PAYMENT)
  regionId          String      @map("region_id")
  currency          String      @db.Char(3)
  subtotalMinor     Int         @map("subtotal_minor")
  discountMinor     Int         @default(0) @map("discount_minor")
  totalMinor        Int         @map("total_minor")
  refundedMinor     Int         @default(0) @map("refunded_minor")
  pricingSnapshot   Json        @map("pricing_snapshot")
  checkoutValues    Json        @default("{}") @map("checkout_values")
  couponCode        String?     @map("coupon_code")
  statusMessage     Json?       @map("status_message")
  metadata          Json        @default("{}")
  /// When payment settled. Null until it does; the trust metrics measure
  /// fulfillment time from here rather than from when the order was opened.
  paidAt            DateTime?   @map("paid_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  customer        Customer?              @relation(fields: [customerId], references: [id])
  session         CustomerSession?       @relation(fields: [sessionId], references: [id])
  checkoutSession CheckoutSession        @relation(fields: [checkoutSessionId], references: [id])
  region          Region                 @relation(fields: [regionId], references: [id])
  items           OrderItem[]
  fulfillments    Fulfillment[]
  paymentIntents  PaymentIntent[]
  reservations    InventoryReservation[]
  redemptions     CouponRedemption[]
  rewardsIssued   CustomerReward[]       @relation("RewardSourceOrder")
  rewardsRedeemed CustomerReward[]       @relation("RewardRedeemedOrder")
  easyDrop        EasyDrop?

  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
  @@index([status])
  @@map("orders")
}

/// Names and prices are copied, not joined: renaming a product must not rewrite
/// what a customer sees they bought.
model OrderItem {
  id                String            @id
  orderId           String            @map("order_id")
  offerId           String            @map("offer_id")
  productId         String            @map("product_id")
  variantId         String            @map("variant_id")
  platformId        String            @map("platform_id")
  regionId          String            @map("region_id")
  quantity          Int
  unitPriceMinor    Int               @map("unit_price_minor")
  totalPriceMinor   Int               @map("total_price_minor")
  displayName       Json              @map("display_name")
  displayVariant    Json              @map("display_variant")
  imageUrl          String?           @map("image_url")
  fulfillmentMethod FulfillmentMethod @map("fulfillment_method")
  fulfillmentStatus FulfillmentStatus @default(PENDING) @map("fulfillment_status")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer       Offer          @relation(fields: [offerId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  platform    Platform       @relation(fields: [platformId], references: [id])
  region      Region         @relation(fields: [regionId], references: [id])
  fulfillment Fulfillment?

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

/// No card number, expiry or CVV is stored, here or anywhere. The only payment
/// identifiers held are the provider's own opaque references.
model PaymentIntent {
  id                String            @id
  orderId           String            @map("order_id")
  checkoutSessionId String            @map("checkout_session_id")
  provider          PaymentProviderId
  providerIntentId  String?           @map("provider_intent_id")
  amountMinor       Int               @map("amount_minor")
  currency          String            @db.Char(3)
  status            PaymentStatus     @default(CREATED)
  failureCode       String?           @map("failure_code")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  events          PaymentEvent[]

  @@index([orderId, status])
  @@map("payment_intents")
}

model PaymentEvent {
  id              String            @id
  paymentIntentId String            @map("payment_intent_id")
  provider        PaymentProviderId
  providerEventId String            @map("provider_event_id")
  type            String
  statusBefore    PaymentStatus?    @map("status_before")
  statusAfter     PaymentStatus?    @map("status_after")
  payloadRedacted Json              @map("payload_redacted")
  receivedAt      DateTime          @default(now()) @map("received_at")

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  // Webhook replay protection at the storage layer.
  @@unique([provider, providerEventId], name: "payment_event_provider_unique")
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Fulfillment
// ---------------------------------------------------------------------------

model Fulfillment {
  id                  String            @id
  orderId             String            @map("order_id")
  orderItemId         String            @unique @map("order_item_id")
  method              FulfillmentMethod
  status              FulfillmentStatus @default(PENDING)
  provider            String?
  providerJobId       String?           @map("provider_job_id")
  attempts            Int               @default(0)
  estimatedReadyAt    DateTime?         @map("estimated_ready_at")
  deliveredAt         DateTime?         @map("delivered_at")
  /// Withheld until the order is paid; the service refuses to read it earlier.
  deliveryPayload     Json?             @map("delivery_payload")
  /// What the customer must do for delivery to be possible: the exact transfer-
  /// market listings for a coin order. Unlike `deliveryPayload` this is shown
  /// *before* delivery, because the customer performs the listing. It carries no
  /// secret: a player name and a price, never a credential.
  customerInstruction Json?             @map("customer_instruction")
  failureReason       Json?             @map("failure_reason")
  operatorId          String?           @map("operator_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  events    FulfillmentEvent[]

  @@index([status, createdAt])
  @@map("fulfillments")
}

model FulfillmentEvent {
  id            String             @id
  fulfillmentId String             @map("fulfillment_id")
  type          String
  statusBefore  FulfillmentStatus? @map("status_before")
  statusAfter   FulfillmentStatus? @map("status_after")
  detail        Json?
  actorType     ActorType          @map("actor_type")
  actorId       String?            @map("actor_id")
  createdAt     DateTime           @default(now()) @map("created_at")

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId, createdAt])
  @@map("fulfillment_events")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model Promotion {
  id             String        @id
  slug           String        @unique
  kind           PromotionKind
  title          Json
  description    Json
  percentOff     Float?        @map("percent_off")
  amountOffMinor Int?          @map("amount_off_minor")
  currency       String?       @db.Char(3)
  gameIds        String[]      @default([]) @map("game_ids")
  productIds     String[]      @default([]) @map("product_ids")
  regionIds      String[]      @default([]) @map("region_ids")
  bannerImageUrl String?       @map("banner_image_url")
  startsAt       DateTime      @map("starts_at")
  endsAt         DateTime?     @map("ends_at")
  active         Boolean       @default(true)

  coupons Coupon[]

  @@map("promotions")
}

model Coupon {
  id               String    @id
  code             String    @unique
  promotionId      String    @map("promotion_id")
  minSubtotalMinor Int?      @map("min_subtotal_minor")
  maxRedemptions   Int?      @map("max_redemptions")
  maxPerCustomer   Int       @default(1) @map("max_per_customer")
  redemptionCount  Int       @default(0) @map("redemption_count")
  expiresAt        DateTime? @map("expires_at")
  active           Boolean   @default(true)

  promotion   Promotion          @relation(fields: [promotionId], references: [id])
  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id          String   @id
  couponId    String   @map("coupon_id")
  orderId     String   @map("order_id")
  customerId  String?  @map("customer_id")
  amountMinor Int      @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId], name: "coupon_once_per_order")
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Review {
  id                String   @id
  productId         String?  @map("product_id")
  customerId        String?  @map("customer_id")
  /// The paid order behind a verified review. One review per order, and a
  /// review claims `verifiedPurchase` only when this is set.
  orderId           String?  @unique @map("order_id")
  authorDisplayName String   @map("author_display_name")
  rating            Int
  title             String?
  body              String
  verifiedPurchase  Boolean  @default(false) @map("verified_purchase")
  published         Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")

  product  Product?  @relation(fields: [productId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([productId, createdAt])
  @@map("reviews")
}

model FaqEntry {
  id        String       @id
  topic     SupportTopic
  question  Json
  answer    Json
  sortOrder Int          @default(0) @map("sort_order")

  @@map("faq_entries")
}

model SupportTicket {
  id           String              @id
  reference    String              @unique
  customerId   String?             @map("customer_id")
  orderId      String?             @map("order_id")
  topic        SupportTopic
  status       SupportTicketStatus @default(OPEN)
  contactEmail String              @map("contact_email")
  subject      String
  message      String
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("support_tickets")
}

// ---------------------------------------------------------------------------
// Cross-cutting
// ---------------------------------------------------------------------------

/// Postgres-backed so it survives a process restart, which an in-memory map
/// would not. `requestHash` detects a key reused with a different body.
model IdempotencyKey {
  key            String            @map("key")
  endpoint       String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at")
  expiresAt      DateTime          @map("expires_at")

  @@id([key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Append-only. The application role has no UPDATE or DELETE grant on this
/// table in a production deployment.
model AuditLog {
  id          BigInt    @id @default(autoincrement())
  eventType   String    @map("event_type")
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  actorType   ActorType @map("actor_type")
  actorId     String?   @map("actor_id")
  requestId   String?   @map("request_id")
  beforeState Json?     @map("before_state")
  afterState  Json?     @map("after_state")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_logs")
}

/// Fixed-window rate limiting, in the database so a restart does not reset a
/// customer's budget and so several instances share one counter.
model RateLimitCounter {
  bucket     String   @id
  count      Int      @default(0)
  windowEnds DateTime @map("window_ends")

  @@index([windowEnds])
  @@map("rate_limit_counters")
}

// ---------------------------------------------------------------------------
// Growth: the reward ledger, EasyDrop, EasyClub, referral, campaigns
//
// Every row here describes something a customer earned from a real paid order,
// or configuration an operator wrote. Nothing is inferred on the client: the
// storefront reads these and renders them. Points and tiers are NOT stored;
// they are computed from paid orders and this ledger on every read, so a
// refund removes them without a second bookkeeping system to keep in step.
// ---------------------------------------------------------------------------

/// What a reward does. The `value` on a reward is read according to its kind:
/// coins, agorot, points, a multiplier in hundredths (200 = x2), or tiers.
enum RewardKind {
  NEXT_ORDER_COINS
  NEXT_ORDER_CREDIT
  POINTS_BONUS
  POINTS_MULTIPLIER
  TIER_BOOST
  OFFER_UNLOCK
  EXTRA_COINS
}

enum RewardSource {
  EASYDROP
  EASYBACK
  REFERRAL_REFERRER
  REFERRAL_FRIEND
  STREAK
  FOUNDER
  CAMPAIGN
}

/// AVAILABLE -> RESERVED (an order is being placed with it) -> REDEEMED (that
/// order was paid). RESERVED goes back to AVAILABLE if the order is cancelled
/// or expires. EXPIRED and REVOKED are terminal.
enum RewardStatus {
  AVAILABLE
  RESERVED
  REDEEMED
  EXPIRED
  REVOKED
}

enum EasyDropTier {
  DROP
  DROP_PLUS
  VIP
}

enum EasyDropStatus {
  ISSUED
  REVEALED
  VOID
}

enum CampaignKind {
  WEEKEND_DROP
  MATCHDAY_DROP
  PAYDAY_DROP
  PROMO_DROP
  COMMUNITY_DROP
  VIP_DROP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

/// Operator-editable configuration for every growth programme, keyed by
/// setting name with a JSON value. Code carries conservative defaults for
/// each key; a row here overrides one. See `modules/growth/growth-config.ts`.
model GrowthSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("growth_settings")
}

/// The reward ledger. One row per reward a customer holds, held or spent.
///
/// Ownership mirrors orders: a signed-in customer's rewards carry the
/// customer id; a guest's carry the browser session that earned them and move
/// to the customer when they sign in. A reward is issued at most once per
/// source and order, which is what makes a replayed webhook or a double
/// reveal unable to mint a second one.
model CustomerReward {
  id              String       @id
  customerId      String?      @map("customer_id")
  sessionId       String?      @map("session_id")
  source          RewardSource
  kind            RewardKind
  value           Int
  status          RewardStatus @default(AVAILABLE)
  title           Json
  sourceOrderId   String?      @map("source_order_id")
  redeemedOrderId String?      @map("redeemed_order_id")
  /// Smallest order subtotal, in minor units, the reward may be used on.
  minOrderMinor   Int?         @map("min_order_minor")
  expiresAt       DateTime?    @map("expires_at")
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  customer      Customer?        @relation(fields: [customerId], references: [id])
  session       CustomerSession? @relation(fields: [sessionId], references: [id])
  sourceOrder   Order?           @relation("RewardSourceOrder", fields: [sourceOrderId], references: [id])
  redeemedOrder Order?           @relation("RewardRedeemedOrder", fields: [redeemedOrderId], references: [id])
  easyDrop      EasyDrop?

  @@unique([source, sourceOrderId], name: "reward_once_per_source_order")
  @@index([customerId, status])
  @@index([sessionId, status])
  @@map("customer_rewards")
}

/// One EasyDrop per paid order. The three cards are drawn once, at issue, and
/// stored; the reveal only records which card was picked. A refresh therefore
/// shows the same reward, and a second reveal is refused by the row itself.
model EasyDrop {
  id          String         @id
  orderId     String         @unique @map("order_id")
  customerId  String?        @map("customer_id")
  sessionId   String?        @map("session_id")
  tier        EasyDropTier
  status      EasyDropStatus @default(ISSUED)
  cards       Json
  pickedIndex Int?           @map("picked_index")
  rewardId    String?        @unique @map("reward_id")
  issuedAt    DateTime       @default(now()) @map("issued_at")
  revealedAt  DateTime?      @map("revealed_at")

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reward CustomerReward? @relation(fields: [rewardId], references: [id])

  @@index([customerId])
  @@index([sessionId])
  @@map("easy_drops")
}

/// The founders programme: the first N customers with a paid order, seated in
/// the order they paid. A seat is permanent and numbered; the count of seats
/// is the only source for "spots remaining".
model FounderSeat {
  customerId String   @id @map("customer_id")
  seatNumber Int      @unique @map("seat_number")
  orderId    String   @map("order_id")
  grantedAt  DateTime @default(now()) @map("granted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("founder_seats")
}

/// A referral identity per customer. Created on first request, never rotated.
model ReferralCode {
  customerId String   @id @map("customer_id")
  code       String   @unique
  createdAt  DateTime @default(now()) @map("created_at")

  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attributions ReferralAttribution[]

  @@map("referral_codes")
}

/// Who arrived through whose link. Attached to the visitor's session (and
/// customer once known); qualified only by that visitor's first paid order.
model ReferralAttribution {
  id                 String         @id
  code               String
  referrerCustomerId String         @map("referrer_customer_id")
  referredCustomerId String?        @unique @map("referred_customer_id")
  referredSessionId  String?        @map("referred_session_id")
  status             ReferralStatus @default(PENDING)
  orderId            String?        @unique @map("order_id")
  reason             String?
  requestIp          String?        @map("request_ip")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  referral ReferralCode @relation(fields: [code], references: [code])

  @@index([referredSessionId])
  @@index([referrerCustomerId, status])
  @@map("referral_attributions")
}

/// A drop in the Drop Zone. Its effective state is computed from `status` and
/// the dates: a scheduled drop becomes active when `startsAt` passes and ends
/// when `endsAt` does. No countdown exists without a real `endsAt`.
model Campaign {
  id           String         @id
  slug         String         @unique
  kind         CampaignKind
  status       CampaignStatus @default(DRAFT)
  title        Json
  lede         Json
  points       Json           @default("[]")
  startsAt     DateTime?      @map("starts_at")
  endsAt       DateTime?      @map("ends_at")
  eligibility  Json           @default("{}")
  reward       Json?
  capTotal     Int?           @map("cap_total")
  claimedCount Int            @default(0) @map("claimed_count")
  ctaLabel     Json?          @map("cta_label")
  ctaLink      String?        @map("cta_link")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  claims CampaignClaim[]

  @@index([status, startsAt])
  @@map("campaigns")
}

/// One claim per campaign and order; the cap is enforced by a conditional
/// increment on the campaign row.
model CampaignClaim {
  id         String   @id
  campaignId String   @map("campaign_id")
  customerId String?  @map("customer_id")
  sessionId  String?  @map("session_id")
  orderId    String   @map("order_id")
  rewardId   String?  @map("reward_id")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, orderId], name: "campaign_once_per_order")
  @@index([campaignId, customerId])
  @@map("campaign_claims")
}
