{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://easy-coins.vercel.app/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://easy-coins.vercel.app/api/v1/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
